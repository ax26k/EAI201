def team_score_odds(row):
    feats = ['victory_pct','net_goals','squad_avg_age','rank']
    X = np.array([row[feats]])
    Xs = scaler.transform(X)
    prob = model.predict_proba(Xs)[0][1]
    return float(prob)

def comparative_probs(pA, pB, eps=1e-6):
    pA = np.clip(pA, eps, 1-eps)
    pB = np.clip(pB, eps, 1-eps)
    
    # ---- CALIBRATE: compress extreme probs using logit + temperature ----
    logitA = np.log(pA / (1 - pA))
    logitB = np.log(pB / (1 - pB))
    
    # Apply temperature (higher = more moderate)
    temp = 2.0
    logitA /= temp
    logitB /= temp
    
   
    expA = np.exp(logitA)
    expB = np.exp(logitB)
    total = expA + expB
    rA = expA / total
    rB = expB / total
    return rA, rB

