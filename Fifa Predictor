def find_image_file(base_name):
    for ext in (".png", ".jpg", ".jpeg", ".webp"):
        path = base_name if base_name.lower().endswith(ext) else base_name + ext
        if os.path.exists(path):
            return path
    return None

def add_bg_from_local(image_file_base):
    path = find_image_file(image_file_base)
    if path is None:
        st.warning(f"Background '{image_file_base}' not found — using dark solid.")
        st.markdown("<style>[data-testid='stAppViewContainer'] {background-color:#0a0a0a;}</style>", unsafe_allow_html=True)
        return
    with open(path, "rb") as f:
        data = f.read()
    encoded = base64.b64encode(data).decode()
    st.markdown(
        f"""
        <style>
        [data-testid="stAppViewContainer"] {{
            background-image: url("data:image/png;base64,{encoded}");
