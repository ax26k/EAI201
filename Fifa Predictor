st.markdown("<div class='section-title'>Compare Two Teams</div>", unsafe_allow_html=True)

teams = data['nation'].sort_values().unique().tolist()
c1, c2 = st.columns(2)

with c1:
    idx_a = teams.index("Argentina") if "Argentina" in teams else 0
    teamA = st.selectbox("Select Team 1", teams, index=idx_a)

with c2:
    idx_b = teams.index("France") if "France" in teams else 0
    teamB = st.selectbox("Select Team 2", teams, index=idx_b)

if st.button("Predict Head-to-Head"):
    if teamA == teamB:
        st.warning("Please select two different teams.")
    else:
        rowA = data[data['nation']==teamA].iloc[0]
        rowB = data[data['nation']==teamB].iloc[0]

        pA_raw = team_score_odds(rowA)
        pB_raw = team_score_odds(rowB)

        # Now uses tempered softmax → realistic probabilities
        pA_rel, pB_rel = comparative_probs(pA_raw, pB_raw)
        pA_pct = pA_rel * 100
        pB_pct = pB_rel * 100

        winner = teamA if pA_rel > pB_rel else teamB
        st.success(f"Predicted Winner: **{winner}**")
        st.info(f"Winning Probability — **{teamA}: {pA_pct:.1f}%** | **{teamB}: {pB_pct:.1f}%**")

        st.markdown(f"<div class='small-muted'>Model: <b>{model_name}</b>. Probabilities calibrated for realism.</div>", unsafe_allow_html=True)

        # ---- Comparison Table ----
        metrics = ["victory_pct","net_goals","squad_avg_age","rank"]
        names = {"victory_pct":"Win %","net_goals":"Net Goals","squad_avg_age":"Avg Squad Age","rank":"FIFA Rank"}

        df = pd.DataFrame({
            "Metric": [names[m] for m in metrics],
            teamA: [rowA[m] for m in metrics],
            teamB: [rowB[m] for m in metrics]
        })
        st.markdown("### Comparison / Justification")
        st.dataframe(df.style.format({teamA:"{:.2f}", teamB:"{:.2f}"}))

        # ---- Per-metric highlights ----
        st.markdown("**Per-metric summary:**")
        for m, name in zip(metrics, [names[m] for m in metrics]):
            a, b = float(rowA[m]), float(rowB[m])
            better = (a < b) if m == "rank" else (a > b)
            if better:
                st.markdown(f"<div class='metric-winner'>{teamA} better **{name}** ({a:.2f}) vs {teamB} ({b:.2f})</div>", unsafe_allow_html=True)
            else:
                st.markdown(f"<div class='metric-loser'>{teamB} better **{name}** ({b:.2f}) vs {teamA} ({a:.2f})</div>", unsafe_allow_html=True)

        

